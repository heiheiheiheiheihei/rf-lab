# RF-Lab 固件默认配置(ESP-IDF 5.5.x / ESP32-S3)
#
# 只放"有设计依据"的项。每条后面的 ⚠️ 说明为什么不能随手改。

CONFIG_IDF_TARGET="esp32s3"

# --- Flash:16MB(N16R8)--------------------------------------------------
# 板子是 N16R8;写成 4MB 会让 16MB 的模组被当成小容量,后续 OTA/存储都会受限。
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- 控制通道:CH343P → UART0(GPIO43/44),协议帧独占这条流 ---------------
# 🔴 2026-10-21 决策变更(实测驱动):
#   · 原生 USB Serial/JTAG 在**本板**从未枚举成功:2026-10-18 单次尝试 9.4 分钟、
#     435 次 connect、438 次 error -71、**0 次成功**;2026-10-21 换另一 Type-C 口
#     150s 内零事件。⇒ 它不能承担"唯一控制通道"。
#   · 唯一已证实可用的通路是 **CH343P(1a86:55d3)→ UART0**。
#
# 代价(必须承认):控制与日志**不能再共用一条流**。这里选择让 UART0 归协议独占,
# 控制台整体关闭 —— 日志是排障手段,协议是产品功能,不能为了日志牺牲协议。
# 排障仍有两条路:① 复位后 **115200** 能看到 ROM bootloader 横幅;App 启动后的
# `# RF-Lab ...` 横幅与协议帧都在 **921600**(2026-10-25 实测:ROM 输出路径也能跑 921600)。
# ② 需要完整 IDF 日志时用 -DRFLAB_DEBUG_CONSOLE 另编一版。
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# ⚠️ 必须显式关掉二级 USB Serial/JTAG 控制台:IDF 5.x 在 S3 上默认把它设为 y,
#    它会把日志复制进原生 USB 设备,与"一个口一个角色"直接冲突(曾真实踩到)。

# --- 串口监视 ----------------------------------------------------------
# 与 App 的协议波特率一致;ROM bootloader 那几行是 115200,在监视器里会是乱码,属正常。
# ⚠️ L-01:IDF 5.5 的 CONFIG_ESPTOOLPY_MONITOR_BAUD 是**看不见来源的 int**
#    (Kconfig 里没有 prompt,默认值 = 控制台波特率;本项目控制台为 NONE ⇒ 恒 115200),
#    因此 sdkconfig.defaults **无法**覆盖它;生成的 sdkconfig 里它显示 115200 不是漂移。
#    真正决定 serial monitor 波特率的是 platformio.ini 的 `monitor_speed = 921600`
#    (PIO monitor 直接用它,不读这个 Kconfig 值)。旧版本这里写的
#    `CONFIG_ESPTOOLPY_MONITOR_BAUD_921600B=y` 是无效符号,已删除以免误导。

# --- FreeRTOS ----------------------------------------------------------
# 指示语的时序分辨率需要 ms 级 tick;1000Hz 让 WS2812 慢闪/快闪的占空比准确。
CONFIG_FREERTOS_HZ=1000

# 主任务栈:默认 3584 B 对 cJSON 递归解析不够(M-05)。cJSON 的
# CJSON_NESTING_LIMIT=1000 只是计数上限,parse_{value,array,object} 是递归实现,
# 对端发来深嵌套 JSON 时 3584 B 栈会溢出重启(违反契约 §1"不崩溃")。
# 提到 8192 B 留出余量;进一步加固(限制 JSON 深度/移入专用任务)是下一批项。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- 日志 --------------------------------------------------------------
# 见上:控制台与日志均关闭(LOG_DEFAULT_LEVEL_NONE)。协议流必须是纯二进制帧。

# --- PSRAM:本批不启用 -------------------------------------------------
# N16R8 是八线(Octal)PSRAM,占用 GPIO33-37(与引脚表"不可用"一致)。
# 阶段 1 骨架不需要 PSRAM;留到捕获缓冲阶段再启用,避免过早引入启动风险。
# 启用时需:CONFIG_SPIRAM=y / CONFIG_SPIRAM_MODE_OCT=y / CONFIG_SPIRAM_SPEED_80M=y
