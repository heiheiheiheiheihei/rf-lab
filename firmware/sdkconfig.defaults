# RF-Lab 固件默认配置(ESP-IDF 5.5.x / ESP32-C3)
#
# 只放"有设计依据"的项。每条后面的 ⚠️ 说明为什么不能随手改。
# 改完必须删掉生成物再编:`rm -f sdkconfig.esp32c3`(它是 .gitignore 里的生成物)。

CONFIG_IDF_TARGET="esp32c3"

# --- Flash:4MB(0.42" OLED 这类 C3 小板的标准配置)------------------------
# 写成更大的容量会让 4MB 的片子被当成大容量;分区表按 4MB 规划。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- 控制台:自己实现,不用 IDF console ---------------------------------
# 固件用两个通道收发行命令:
#   ① 原生 USB-Serial-JTAG(GPIO18/19,板载 Type-C)——C3 上这条通路可靠;
#   ② UART0(GPIO20/21)——兼容外接 USB-TTL/CH340 的玩法。
# 两个通道由 usb_serial_jtag_driver_install() + uart_driver_install(UART0) 直接管,
# 因此必须关掉 IDF 自己的 console,否则日志会和命令行抢同一路 UART。
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# ⚠️ IDF 5.x 在部分目标上默认把二级 console 设成 USB-Serial-JTAG,必须显式关掉。

# --- FreeRTOS ----------------------------------------------------------
CONFIG_FREERTOS_HZ=1000

# 主任务栈:解析 8 字节帧 + NVS 读写 + snprintf,3584 B 偏紧(格式化输出吃栈);
# 提到 8192 B 换余量,代价是一次性 4.5KB 静态 RAM(C3 共 400KB SRAM)。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- 串口监视 ----------------------------------------------------------
# 真正决定 pio device monitor 波特率的是 platformio.ini 的 monitor_speed。
# CONFIG_ESPTOOLPY_MONITOR_BAUD 在 IDF 里是看不见来源的 int,这里不设。
