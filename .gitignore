# 构建产物
# 由 firmware/scripts/embed_web.py 生成(不入库)
firmware/src/web/web_ui_gz.S
build/
.pio/
.pio-core/
.uv-cache/
build.log
upload.log
.pioenvs/
.piolibdeps/
sdkconfig
sdkconfig.old
# PlatformIO 按环境名生成(如 sdkconfig.esp32c3);**真源 sdkconfig.defaults 必须入库**。
# ⚠️ 2026-10-21 修正:原来写的是 `sdkconfig.*`,它把 sdkconfig.defaults 也一起忽略了
#    ⇒ 仓库里从来没有这个文件,clone 下来构建会退回 IDF 默认控制台(日志与协议抢 UART0)。
sdkconfig.esp32*
*.bin
*.elf
*.map

# 固件发布物(CI 从最新 Release 注入 site/firmware/,不提交)
site/firmware/

# 依赖
node_modules/
/dist/
.venv/
__pycache__/
*.pyc

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
*~

# 本地配置(可能含密钥,绝不入库)
*.local.json
secrets.json
.env
.env.*

# Android
android/.gradle/
android/local.properties
android/keystore.properties
android/app/build/
*.apk
*.aab
android/build/
watch/.gradle/
watch/local.properties
watch/keystore.properties
watch/app/build/

# 签名材料
*.jks
*.keystore

# KiCad 本地状态(工程文件本身入库;锁/用户偏好不入库)
hardware/pcb/*.kicad_prl
hardware/pcb/~*.lck
