{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "msg-module_state.schema.json",
  "title": "MODULE_STATE (0x91)",
  "description": "方向:设备→App · 文档 §3.2 · 协议 v1。活动模块状态变化通知。",
  "type": "object",
  "properties": {
    "slot": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/slot"
        }
      ],
      "description": "模块槽位 1..3。"
    },
    "state": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/moduleState"
        }
      ],
      "description": "模块状态。"
    },
    "detail": {
      "type": "string",
      "description": "状态补充说明,自由文本(如 hw_error 的具体原因)。文档未声明何时必须出现,故不列入 required。"
    }
  },
  "required": [
    "slot",
    "state"
  ],
  "additionalProperties": false
}
