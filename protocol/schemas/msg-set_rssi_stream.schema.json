{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "msg-set_rssi_stream.schema.json",
  "title": "SET_RSSI_STREAM (0x22)",
  "description": "方向:App→设备 · 文档 §3.3 · 协议 v1。开启/关闭定点实时 RSSI 流。",
  "type": "object",
  "properties": {
    "f_hz": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/frequencyHz"
        }
      ],
      "description": "定点观测频率,单位 Hz(整数)。"
    },
    "interval_ms": {
      "type": "number",
      "description": "上报间隔,单位 ms。"
    },
    "enable": {
      "type": "boolean",
      "description": "true 开启,false 关闭。"
    }
  },
  "required": [
    "f_hz",
    "interval_ms",
    "enable"
  ],
  "additionalProperties": false
}
