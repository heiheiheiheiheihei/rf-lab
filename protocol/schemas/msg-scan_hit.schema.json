{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "msg-scan_hit.schema.json",
  "title": "SCAN_HIT (0xA0)",
  "description": "方向:设备→App · 文档 §3.3 · 协议 v1。扫频命中点,仅回超过阈值的点。属高频消息,必须受令牌桶限流(默认 50 msg/s),超限时设备丢旧保新并发 WARN{throttled}(§2.4);被丢弃的条数由 SCAN_DONE.hits_dropped 诚实上报,并可用 GET_SCAN_HITS 分页取回。",
  "type": "object",
  "properties": {
    "scan_id": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/scanId"
        }
      ],
      "description": "本次扫描的会话标识。"
    },
    "f_hz": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/frequencyHz"
        }
      ],
      "description": "命中频率,单位 Hz(整数)。"
    },
    "rssi_dbm": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/rssi"
        }
      ],
      "description": "该点的接收信号强度,单位 dBm。"
    },
    "t_ms": {
      "type": "number",
      "description": "命中时刻,单位 ms。"
    }
  },
  "required": [
    "scan_id",
    "f_hz",
    "rssi_dbm",
    "t_ms"
  ],
  "additionalProperties": false
}
