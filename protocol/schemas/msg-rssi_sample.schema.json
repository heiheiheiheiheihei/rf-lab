{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "msg-rssi_sample.schema.json",
  "title": "RSSI_SAMPLE (0xA3)",
  "description": "方向:设备→App · 文档 §3.3 · 协议 v1。定点实时 RSSI 采样值。高频消息,受 §2.4 限流约束。",
  "type": "object",
  "properties": {
    "f_hz": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/frequencyHz"
        }
      ],
      "description": "观测频率,单位 Hz(整数)。"
    },
    "rssi_dbm": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/rssi"
        }
      ],
      "description": "接收信号强度,单位 dBm。"
    },
    "t_ms": {
      "type": "number",
      "description": "采样时刻,单位 ms。"
    }
  },
  "required": [
    "f_hz",
    "rssi_dbm",
    "t_ms"
  ],
  "additionalProperties": false
}
